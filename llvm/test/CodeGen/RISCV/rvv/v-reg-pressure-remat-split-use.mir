# RUN: llc %s -mtriple=riscv64 -mattr=+v,+zvl1024b -run-pass=riscv-v-reg-pressure-remat -riscv-rvv-pressure-dag-sched -riscv-rvv-pressure-remat -o - | FileCheck %s
# RUN: llc %s -mtriple=riscv64 -mattr=+v,+zvl1024b -run-pass=riscv-v-reg-pressure-remat -riscv-rvv-pressure-dag-sched -o - | FileCheck %s --check-prefix=DAGONLY

# CHECK-LABEL: name: remat_late_reduction
# CHECK: [[LOAD:%[0-9]+]]:vrm4 = PseudoVLE32_V_M4 $noreg, %0, %3
# CHECK: [[ADD:%[0-9]+]]:vrm4 = nofpexcept PseudoVFADD_VV_M4_E32 $noreg, [[LOAD]], [[LOAD]]
# CHECK: PseudoVSE32_V_M4 killed [[ADD]]
# CHECK: [[RED:%[0-9]+]]:vr = nofpexcept PseudoVFREDOSUM_VS_M4_E32 $noreg, [[LOAD]]
# CHECK-NOT: PseudoVLE32_V_M4
# CHECK: PseudoVSE32_V_M1 killed [[RED]]

# DAGONLY-LABEL: name: remat_late_reduction
# DAGONLY: %4:vrm4 = PseudoVLE32_V_M4 $noreg, %0, %3
# DAGONLY-NOT: PseudoVLE32_V_M4
# DAGONLY: %7:vrm4 = nofpexcept PseudoVFADD_VV_M4_E32 $noreg, %4, %4
# DAGONLY: PseudoVSE32_V_M4 killed %7
# DAGONLY: %6:vr = nofpexcept PseudoVFREDOSUM_VS_M4_E32 $noreg, %4
# DAGONLY-NOT: PseudoVLE32_V_M4
# DAGONLY: PseudoVSE32_V_M1 killed %6
---
name:            remat_late_reduction
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gprnox0 }
  - { id: 4, class: vrm4 }
  - { id: 5, class: vr }
  - { id: 6, class: vr }
  - { id: 7, class: vrm4 }
  - { id: 8, class: vr }
  - { id: 9, class: vr }
  - { id: 10, class: vr }
  - { id: 11, class: vr }
  - { id: 12, class: vr }
  - { id: 13, class: vr }
  - { id: 14, class: vr }
  - { id: 15, class: vr }
  - { id: 16, class: vr }
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
  - { reg: '$x11', virtual-reg: '%1' }
  - { reg: '$x12', virtual-reg: '%2' }
body:             |
  bb.0:
    liveins: $x10, $x11, $x12

    %2:gpr = COPY $x12
    %1:gpr = COPY $x11
    %0:gpr = COPY $x10
    %3:gprnox0 = ADDI $x0, 128
    %8:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %9:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %10:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %11:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %12:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %13:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %14:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %4:vrm4 = PseudoVLE32_V_M4 $noreg, %0, %3, 5, 2 :: (load (s4096))
    %5:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %7:vrm4 = nofpexcept PseudoVFADD_VV_M4_E32 $noreg, %4, %4, 7, %3, 5, 1, implicit $frm
    PseudoVSE32_V_M4 killed %7, %1, %3, 5 :: (store (s4096))
    %15:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %16:vr = PseudoVMV_S_X $noreg, $x0, %3, 5
    %6:vr = nofpexcept PseudoVFREDOSUM_VS_M4_E32 $noreg, %4, killed %5, 7, %3, 5, 1, implicit $frm
    PseudoVSE32_V_M1 killed %6, %2, 1, 5 :: (store (s32))
    PseudoRET
...
