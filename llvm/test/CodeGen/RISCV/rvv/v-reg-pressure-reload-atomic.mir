tracksRegLiveness: true
registers:
  - { id: 0, class: gpr }
  - { id: 1, class: gpr }
  - { id: 2, class: gpr }
  - { id: 3, class: gprnox0 }
  - { id: 4, class: vrm4 }
  - { id: 5, class: vr }
  - { id: 6, class: vr }
  - { id: 7, class: vrm4 }
  - { id: 8, class: vr }
  - { id: 9, class: vr }
  - { id: 10, class: vr }
  - { id: 11, class: vr }
  - { id: 12, class: vr }
  - { id: 13, class: vr }
  - { id: 14, class: vr }
liveins:
  - { reg: '$x10', virtual-reg: '%0' }
