# RUN: llc -mtriple=riscv64 -mattr=+xsfmmbase -run-pass=greedy,virtregrewriter %s -o - | FileCheck %s

--- |
  define void @tile_regalloc() { ret void }
...
---
name: tile_regalloc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10, $x11

    ; CHECK-LABEL: name: tile_regalloc
    ; CHECK: renamable $t{{[0-9]+}} = IMPLICIT_DEF
    ; CHECK: PseudoSF_VTZERO_T killed renamable $t{{[0-9]+}},
    %0:gprnox0 = COPY $x10
    %1:gprnox0 = COPY $x11
    %2:tr = IMPLICIT_DEF
    PseudoSF_VTZERO_T %2, %0, %1, 3, 4
    PseudoRET
...
