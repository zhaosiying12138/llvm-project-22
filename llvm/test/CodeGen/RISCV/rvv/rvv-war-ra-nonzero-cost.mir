    $v15 = VL1RE8_V %stack.0 :: (volatile load unknown-size)
    $v16 = VL1RE8_V %stack.0 :: (volatile load unknown-size)
    $v17 = VL1RE8_V %stack.0 :: (volatile load unknown-size)
    $v18 = VL1RE8_V %stack.0 :: (volatile load unknown-size)
